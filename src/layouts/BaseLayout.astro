---
import "../styles/base/global.css";
import "../styles/base/background.css";
import "../styles/base/layout.css";
import Footer from "../components/sections/Footer.astro";
import WebsiteSchema from "../components/seo/WebsiteSchema.astro";
import ArticleSchema from "../components/seo/ArticleSchema.astro";

const {
    title = "AutoLogika | Belajar Otomotif Modern",
    description = "Belajar otomotif modern melalui artikel, video, dan infografis yang mudah dipahami.",
    image = "/og-image.webp",
    type = "website",
    article = null,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
---

<!DOCTYPE html>
<html lang="id">
<head>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <title>{title}</title>

    <meta
    name="description"
    content={description}
    />

    <link rel="canonical" href={canonicalURL} />

    <WebsiteSchema />

    {article && <ArticleSchema article={article} />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="AutoLogika.id" />
    <meta property="og:locale" content="id_ID" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <link
    rel="icon"
    type="image/webp"
    href="/favicon.webp"
    />
    <!-- Google Analytics -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-0GF96L9PYL"></script>
<script is:inline>
window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', 'G-0GF96L9PYL');
</script>

</head>

<body>

    <div class="bg-system">

        <div class="bg-grid"></div>

        <div class="bg-noise"></div>

        <div class="bg-glow bg-glow-red"></div>

        <div class="bg-glow bg-glow-blue"></div>

    </div>

    <main class="site-content">

        <slot />

    </main>

    <Footer />

</body>

</html>