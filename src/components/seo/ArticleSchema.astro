---
const { article } = Astro.props;

const articleUrl = `https://autologika.id/article/${article.slug}/`;

const imageUrl = article.image
    ? new URL(article.image, "https://autologika.id").toString()
    : undefined;

const schema = {
    "@context": "https://schema.org",
    "@type": "Article",

    headline: article.seoTitle ?? article.title,

    description:
        article.seoDescription ??
        article.description,

    datePublished: article.publishedAt
        ? `${article.publishedAt}T00:00:00+07:00`
        : undefined,

    ...(article.updatedAt && {
        dateModified: `${article.updatedAt}T00:00:00+07:00`,
    }),

    author: {
        "@type": "Organization",
        name: article.author || "AutoLogika.id",
        url: "https://autologika.id/",
    },

    publisher: {
        "@type": "Organization",
        name: "AutoLogika.id",

        logo: {
            "@type": "ImageObject",
            url: "https://autologika.id/logoal.webp",
        },
    },

    ...(imageUrl && {
        image: [imageUrl],
    }),

    mainEntityOfPage: {
        "@type": "WebPage",
        "@id": articleUrl,
    },

    inLanguage: "id-ID",
};
---

<script
    type="application/ld+json"
    set:html={JSON.stringify(schema)}
></script>